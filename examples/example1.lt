fn fib(n: u32) -> u64 {
    if n == 0 {
        0
    } else if n == 1 {
        1
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

pub struct time_t {
    different: u64,
}

extern "C" {
    pub fn printf(fmt: str, ...) -> i32;
    pub fn time(t: *mut time_t) -> time_t;
    pub fn difftime(end: time_t, beg: time_t) -> f64;
}

fn main() {
    let start = time();

    printf("%d", fib(35));

    let end = time();

    printf("%f", different(start, end));
}